# App
APP_NAME=rag-interview-backend
ENVIRONMENT=development
LOG_LEVEL=INFO
MAX_UPLOAD_MB=10

# Gemini
GEMINI_API_KEY=
GEMINI_LLM_MODEL=
GEMINI_EMBEDDING_MODEL=
EMBEDDING_DIMENSION=

# Qdrant Cloud
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=documents_chunks

# PostgreSQL (Neon), adapted for asyncpg
DATABASE_URL=

# Redis Cloud
REDIS_URL=
CHAT_HISTORY_MAX_MESSAGES=20
CHAT_TTL_SECONDS=3600

# RAG
DEFAULT_CHUNK_SIZE=800
DEFAULT_CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=4
EMBEDDING_BATCH_SIZE=50
EMBEDDING_MAX_RETRIES=5

RETRIEVAL_MIN_SCORE=0.6
LLM_MAX_RETRIES=5
# LLM_TEMPERATURE=

BOOKING_TIMEZONE=UTC